---
import '../styles/global.css';
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="" />
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      script-src 'unsafe-inline';
      style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
      font-src 'self' https://fonts.gstatic.com data:;
      img-src 'self' data: https://www.google-analytics.com https://www.google.pl;
      script-src-elem 'unsafe-inline' 'self' https://www.googletagmanager.com https://www.google-analytics.com;
      connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com;
    ">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:url" content="https://webkowski.com" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Piotr Łepkowski - Software Engineer" />
    <meta property="og:description" content="Software developer with over 20 years of experience. Deep knowledge across the modern web stack and a proven track record of shipping successful products. Committed to high-quality, scalable software."/>
    <meta property="og:image" content="/images/og-image.png" />
    <meta name="description" content="Software developer with over 20 years of experience. Deep knowledge across the modern web stack and a proven track record of shipping successful products. Committed to high-quality, scalable software."/>

    <!-- apply theme before paint to avoid flash: saved choice > system setting > light -->
    <script is:inline>
      try {
        var s = localStorage.getItem('pl-theme');
        var t = (s === 'dark' || s === 'light') ? s
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8J7EG49QGS"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-8J7EG49QGS');
  </script>
  <body>
    <div class="relative min-h-screen overflow-x-hidden bg-bg text-ink transition-colors duration-300 ease-[ease]">

      <!-- fixed corner brackets -->
      <div class="fixed top-2.5 left-3 font-mono text-[15px] text-bracket z-5 pointer-events-none">┌</div>
      <div class="fixed top-2.5 right-3 font-mono text-[15px] text-bracket z-5 pointer-events-none">┐</div>
      <div class="fixed bottom-2.5 left-3 font-mono text-[15px] text-bracket z-5 pointer-events-none">└</div>
      <div class="fixed bottom-2.5 right-3 font-mono text-[15px] text-bracket z-5 pointer-events-none">┘</div>

      <!-- NAV -->
      <div class="sticky top-0 z-20 bg-nav-bg backdrop-blur-[10px] border-b border-line">
        <div class="max-w-[1080px] mx-auto px-[32px] py-[14px] flex items-center gap-[24px]">
          <a href="/" class="flex items-center gap-[10px] no-underline select-none">
            <span class="font-mono font-bold text-[13px] text-on-accent bg-accent px-[8px] py-[5px] rounded-[3px] tracking-[1px]">pł</span>
            <span class="font-mono text-[13px] text-muted">webkowski.com</span>
          </a>
          <div class="flex-1"></div>
          <div class="flex items-center gap-[22px] font-mono text-[13px]">
            <a href="/" class="nav-link no-underline" data-text="home">home</a>
            <a href="/#services" class="nav-link no-underline" data-text="work">work</a>
            <a href="/projects" class="nav-link no-underline" data-text="projects">projects</a>
            <a href="#contact" class="nav-link no-underline" data-text="contact">contact</a>
            <span id="theme-toggle" class="nav-link text-muted"><span id="theme-label">☾ dark</span></span>
          </div>
          <div class="flex items-center gap-[8px] font-mono text-[12px] text-muted border-l border-line pl-[18px]">
            <span class="w-[7px] h-[7px] rounded-full bg-green-500 animate-[pulse_1.8s_ease-in-out_infinite]"></span>
            <span>Available</span>
          </div>
        </div>
      </div>

      <slot />

      <!-- CONTACT (dark band, shared) -->
      <div id="contact" class="bg-contact-bg text-contact-text mt-[20px]">
        <div class="max-w-[1080px] mx-auto pt-[72px] px-[32px] pb-[40px]">
          <div class="font-mono text-[12px] text-accent mb-[22px]">// let's build something</div>
          <h2 data-text="let's talk." class="text-[clamp(38px,7vw,80px)] font-black tracking-[-2px] mt-0 mx-0 mb-[30px] leading-[.95]">let's talk.</h2>
          <a href="mailto:ozrabal+www@gmail.com" class="email-btn inline-block bg-accent text-on-accent px-[26px] py-[15px] rounded-[3px] font-mono text-[14px] no-underline">ozrabal+www@gmail.com →</a>
          <div class="flex flex-wrap gap-[26px] mt-[38px] font-mono text-[13px]">
            <a href="https://www.linkedin.com/in/lepkowski" target="_blank" rel="noopener noreferrer" class="link-accent text-contact-muted no-underline">linkedin ↗</a>
            <a href="https://github.com/ozrabal" target="_blank" rel="noopener noreferrer" class="link-accent text-contact-muted no-underline">github ↗</a>
            <a href="https://subiektywny.com" target="_blank" rel="noopener noreferrer" class="link-accent text-contact-muted no-underline">photography ↗</a>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-[16px] mt-[54px] pt-[22px] border-t border-contact-line font-mono text-[11.5px] text-contact-dim">
            <span>© 2026 Piotr Łepkowski · software engineer</span>
            <span>this site uses cookies</span>
          </div>
        </div>
      </div>

    </div>

    <!-- shared behaviour: theme toggle, live clock, scramble-on-hover -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function label(t) { return t === 'dark' ? '☀ light' : '☾ dark'; }
        function apply(t) {
          root.setAttribute('data-theme', t);
          var l = document.getElementById('theme-label');
          if (l) l.textContent = label(t);
        }
        var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
        function stored() { try { var s = localStorage.getItem('pl-theme'); return (s === 'dark' || s === 'light') ? s : null; } catch (e) { return null; } }
        function preferred() { return stored() || (mq && mq.matches ? 'dark' : 'light'); }
        apply(preferred());
        var btn = document.getElementById('theme-toggle');
        if (btn) btn.addEventListener('click', function () {
          var cur = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          var next = cur === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('pl-theme', next); } catch (e) {}
          apply(next);
        });
        // follow OS changes until the user makes an explicit choice
        if (mq) {
          var onChange = function () { if (!stored()) apply(mq.matches ? 'dark' : 'light'); };
          if (mq.addEventListener) mq.addEventListener('change', onChange);
          // legacy Safari <14 fallback: reach the deprecated addListener via an untyped alias
          else { var legacyMq = /** @type {any} */ (mq); if (legacyMq.addListener) legacyMq.addListener(onChange); }
        }

        // scramble-on-hover
        var chars = '!<>-_\\/[]{}=+*^?#·:';
        document.querySelectorAll('[data-text]').forEach(function (el) {
          el.addEventListener('mouseenter', function () {
            var final = el.dataset.text;
            if (!final) return;
            var frame = 0;
            clearInterval(el._iv);
            el._iv = setInterval(function () {
              var reveal = frame / 2, out = '';
              for (var i = 0; i < final.length; i++) {
                if (i < reveal || final[i] === ' ') out += final[i];
                else out += chars[Math.floor(Math.random() * chars.length)];
              }
              el.textContent = out;
              frame++;
              if (reveal >= final.length) { clearInterval(el._iv); el.textContent = final; }
            }, 26);
          });
        });
      })();
    </script>
  </body>
</html>
