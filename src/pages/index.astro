---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Piotr Łepkowski - Software Engineer">
  <div id="top" class="max-w-[1080px] mx-auto px-[32px]">

    <!-- HERO -->
    <section class="pt-[58px] pb-[50px]">
      <div class="flex flex-wrap gap-[18px] items-center">
        <div class="flex-[1_1_360px] min-w-[330px]">
          <div class="font-mono text-[14px] leading-[1.9] text-ink"><span class="text-accent">➜</span> <span class="text-muted">~</span> whoami</div>
          <h1 class="font-sans font-extrabold text-[clamp(30px,4.2vw,50px)] leading-[.98] tracking-[-1.5px] mt-[6px] mx-0 mb-[4px] whitespace-nowrap">Piotr Łepkowski<span class="text-accent">.</span></h1>
          <div class="font-mono text-[16px] text-accent min-h-[24px] mt-[6px] mx-0 mb-[20px]"><span id="role-text"></span><span class="inline-block w-[8px] h-[15px] bg-accent ml-[3px] translate-y-[2px] animate-[blink_1s_step-end_infinite]"></span></div>
          <p class="max-w-[48ch] text-[16.5px] leading-[1.62] text-text mt-0 mx-0 mb-[28px]">Software developer with over 15 years of experience. Deep knowledge across the modern web stack and a proven track record of shipping successful products. Committed to high-quality, scalable software. Besides code, I take <a href="https://subiektywny.com" target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-accent underline-offset-[3px]">photos</a>.</p>
          <div class="flex flex-wrap gap-[14px] font-mono text-[13px]">
            <a href="/projects" class="btn-primary bg-accent text-on-accent border-none px-[22px] py-[13px] rounded-[3px] no-underline text-[13px]">see_projects →</a>
            <a href="#contact" class="btn-ghost bg-transparent text-ink border border-line40 px-[22px] py-[13px] rounded-[3px] no-underline text-[13px]">let's_talk</a>
            <a href="https://subiektywny.com" target="_blank" rel="noopener noreferrer" class="link-accent inline-flex items-center px-[4px] py-[13px] text-muted no-underline">photos ↗</a>
          </div>
        </div>
        <div class="flex-[1.5_1_420px] min-w-[300px] flex flex-col items-stretch gap-[10px]">
          <canvas id="net-canvas" aria-hidden="true" class="w-full h-[clamp(240px,32vh,340px)]"></canvas>
          <div id="net-stats" class="flex flex-wrap gap-[16px] font-mono text-[11px] text-muted">
            <span>epoch <span id="st-epoch" class="text-ink">0000</span></span>
            <span>loss <span id="st-loss" class="text-accent">0.0000</span></span>
            <span>acc <span id="st-acc" class="text-accent">0.0%</span></span>
            <span>lr <span class="text-ink">3e-4</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="pt-[30px] pb-[18px]">
      <div class="flex items-center gap-[16px] mb-[36px]">
        <span class="font-mono text-[13px] text-accent font-bold">01</span>
        <span data-text="you have an idea, I'll help you make it happen" class="font-mono text-[13px] tracking-[.5px] text-ink font-medium">you have an idea, I'll help you make it happen</span>
        <span class="flex-1 h-px bg-line14"></span>
        <span class="font-mono text-[12px] text-muted">04 services</span>
      </div>
      <div class="grid grid-cols-2 gap-[16px]">
        <div class="card bg-card border border-line rounded-[3px] p-[26px]">
          <div class="font-mono text-[12px] text-accent mb-[14px]">[ 01 ]</div>
          <h3 class="mt-0 mx-0 mb-[8px] text-[21px] font-bold tracking-[-.3px]">Web, SaaS &amp; Mobile Apps</h3>
          <p class="m-0 text-[14.5px] leading-[1.6] text-body">Fast, scalable &amp; secure applications with modern architecture.</p>
        </div>
        <div class="card bg-card border border-line rounded-[3px] p-[26px]">
          <div class="font-mono text-[12px] text-accent mb-[14px]">[ 02 ]</div>
          <h3 class="mt-0 mx-0 mb-[8px] text-[21px] font-bold tracking-[-.3px]">React / Next.js</h3>
          <p class="m-0 text-[14.5px] leading-[1.6] text-body">UI/UX development, application architecture, data visualization, services integration.</p>
        </div>
        <div class="card bg-card border border-line rounded-[3px] p-[26px]">
          <div class="font-mono text-[12px] text-accent mb-[14px]">[ 03 ]</div>
          <h3 class="mt-0 mx-0 mb-[8px] text-[21px] font-bold tracking-[-.3px]">Node.js</h3>
          <p class="m-0 text-[14.5px] leading-[1.6] text-body">Web services, APIs, SDKs, third-party integrations.</p>
        </div>
        <div class="card bg-card border border-line rounded-[3px] p-[26px]">
          <div class="font-mono text-[12px] text-accent mb-[14px]">[ 04 ]</div>
          <h3 class="mt-0 mx-0 mb-[8px] text-[21px] font-bold tracking-[-.3px]">AI</h3>
          <p class="m-0 text-[14.5px] leading-[1.6] text-body">LLM integrations, prompt engineering, agents, automation.</p>
        </div>
      </div>
    </section>

    <!-- SIDE PROJECTS -->
    <section id="side" class="pt-[54px] pb-[18px]">
      <div class="flex items-center gap-[16px] mb-[36px]">
        <span class="font-mono text-[13px] text-accent font-bold">02</span>
        <span data-text="side_projects" class="font-mono text-[13px] tracking-[.5px] text-ink font-medium">side_projects</span>
        <span class="flex-1 h-px bg-line14"></span>
        <span class="font-mono text-[12px] text-muted">building in public</span>
      </div>
      <div class="grid grid-cols-2 gap-[16px]">

        <div class="card bg-card border border-line rounded-[3px] p-[24px] flex gap-[20px]">
          <pre class="font-mono text-[11px] leading-[1.15] m-0 text-accent flex-none"> .----.
 |o  o|
 | -- |
 '----'</pre>
          <div>
            <div class="flex items-center gap-[10px] mb-[7px]"><h3 class="m-0 text-[19px] font-extrabold">Mentor</h3><span class="font-mono text-[10px] text-muted border border-line2 px-[7px] py-[2px] rounded-[99px] whitespace-nowrap">early access soon</span></div>
            <p class="m-0 text-[14px] leading-[1.6] text-body">AI mock-interview simulator. Parses job descriptions, generates role-specific questions, and scores answers in real time — competency breakdowns and hire-probability.</p>
          </div>
        </div>

        <div class="card bg-card border border-line rounded-[3px] p-[24px] flex gap-[20px]">
          <pre class="font-mono text-[11px] leading-[1.15] m-0 text-accent flex-none"> .----.
 |&gt;_  |
 |≡≡≡ |
 '----'</pre>
          <div>
            <div class="flex items-center gap-[10px] mb-[7px]"><h3 class="m-0 text-[19px] font-extrabold">Stencil</h3><span class="font-mono text-[10px] text-accent border border-accent px-[7px] py-[2px] rounded-[99px] whitespace-nowrap">open source</span></div>
            <p class="mt-0 mx-0 mb-[8px] text-[14px] leading-[1.6] text-body">VS Code extension that organizes, searches, and injects reusable AI prompts — with IDE context — into Copilot, Claude or any chat, without leaving your editor.</p>
            <a href="https://github.com/ozrabal/stencil" target="_blank" rel="noopener noreferrer" class="link-accent font-mono text-[12px] text-ink underline decoration-accent underline-offset-[3px]">github.com/ozrabal/stencil ↗</a>
          </div>
        </div>

        <div class="card bg-card border border-line rounded-[3px] p-[24px] flex gap-[20px]">
          <pre class="font-mono text-[11px] leading-[1.15] m-0 text-accent flex-none"> .----.
 |▤▤▤ |
 |▤▤▤ |
 '----'</pre>
          <div>
            <div class="flex items-center gap-[10px] mb-[7px]"><h3 class="m-0 text-[19px] font-extrabold">Muninn</h3><span class="font-mono text-[10px] text-muted border border-line2 px-[7px] py-[2px] rounded-[99px] whitespace-nowrap">early access soon</span></div>
            <p class="m-0 text-[14px] leading-[1.6] text-body">Local-first Markdown library manager. Watches folders, classifies files with on-device embeddings, and builds a searchable private vault — zero cloud, zero manual tagging.</p>
          </div>
        </div>

        <div class="card bg-card border border-line rounded-[3px] p-[24px] flex gap-[20px]">
          <pre class="font-mono text-[11px] leading-[1.15] m-0 text-accent flex-none"> .----.
 |┌┐  |
 | └┘ |
 '----'</pre>
          <div>
            <div class="flex items-center gap-[10px] mb-[7px]"><h3 class="m-0 text-[19px] font-extrabold">PlanMyApp</h3><span class="font-mono text-[10px] text-muted border border-line2 px-[7px] py-[2px] rounded-[99px] whitespace-nowrap">early access soon</span></div>
            <p class="m-0 text-[14px] leading-[1.6] text-body">Planning tool for applications. Outline, design, and strategize app ideas efficiently with AI-powered insights and recommendations.</p>
          </div>
        </div>

      </div>
      <div class="mt-[16px] border border-dashed border-line2 rounded-[3px] px-[24px] py-[18px] font-mono text-[13px] text-muted flex items-center gap-[12px]">
        <span class="text-accent">&gt;</span> more revolutionary ideas coming soon<span class="inline-block w-[8px] h-[15px] bg-muted animate-[blink_1.1s_step-end_infinite]"></span>
      </div>
    </section>

    <div class="h-[64px]"></div>
  </div>

  <!-- home behaviour: role typing + neural-net canvas -->
  <script is:inline>
    (function () {
      // typed role
      var role = 'software engineer · 15+ years';
      var roleEl = document.getElementById('role-text');
      var ri = 0;
      setInterval(function () {
        if (roleEl && ri < role.length) { ri++; roleEl.textContent = role.slice(0, ri); }
      }, 90);

      // neural network canvas
      var net = null;
      function initNet() {
        var layers = [4, 6, 6, 4, 2];
        var nodes = [], byLayer = [];
        layers.forEach(function (count, li) {
          var x = 0.07 + li * 0.86 / (layers.length - 1);
          var ids = [];
          for (var k = 0; k < count; k++) {
            var y = count === 1 ? 0.5 : 0.08 + 0.84 * k / (count - 1);
            ids.push(nodes.length); nodes.push({ x: x, y: y, layer: li, phase: Math.random() * 6.28 });
          }
          byLayer.push(ids);
        });
        var edges = [];
        for (var li = 0; li < byLayer.length - 1; li++)
          for (var ai = 0; ai < byLayer[li].length; ai++)
            for (var bi = 0; bi < byLayer[li + 1].length; bi++) {
              var on = Math.random() < 0.55;
              edges.push({ a: byLayer[li][ai], b: byLayer[li + 1][bi], str: on ? 0.9 : 0, tgt: on ? 1 : 0 });
            }
        net = { layers: layers, byLayer: byLayer, nodes: nodes, edges: edges, pulses: [], last: performance.now(), dash: 0, t: 0, epoch: 0, tSpawn: 0, dispLoss: 0.7, dispAcc: 55 };
      }

      function drawNet(cv) {
        if (!net) initNet();
        var n = net;
        var dpr = window.devicePixelRatio || 1;
        var w = cv.clientWidth, h = cv.clientHeight;
        if (!w || !h) return;
        if (cv.width !== Math.round(w * dpr) || cv.height !== Math.round(h * dpr)) { cv.width = w * dpr; cv.height = h * dpr; }
        var ctx = cv.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);

        var now = performance.now();
        var dt = Math.min(0.05, (now - n.last) / 1000); n.last = now;
        n.t += dt;
        for (var i = 0; i < n.nodes.length; i++) n.nodes[i].act = 0.5 + 0.5 * Math.sin(n.t * 0.32 + n.nodes[i].phase);
        for (var e = 0; e < n.edges.length; e++) {
          var ed = n.edges[e];
          var prod = n.nodes[ed.a].act * n.nodes[ed.b].act;
          ed.tgt = prod > 0.4 ? Math.min(1, (prod - 0.4) * 3.5) : 0;
          ed.str += (ed.tgt - ed.str) * Math.min(1, dt * 0.5);
        }

        n.tSpawn -= dt;
        if (n.tSpawn <= 0 && n.pulses.length < 7) {
          n.tSpawn = 0.7 + Math.random() * 0.7;
          var src = n.byLayer[0][(Math.random() * n.byLayer[0].length) | 0];
          var outs = n.edges.filter(function (x) { return x.a === src && x.str > 0.5; });
          if (outs.length) n.pulses.push({ edge: outs[(Math.random() * outs.length) | 0], t: 0, speed: 0.24 + Math.random() * 0.2 });
        }
        n.pulses = n.pulses.filter(function (p) {
          p.t += dt * p.speed;
          if (p.t >= 1) {
            var arrive = p.edge.b;
            var o = n.edges.filter(function (x) { return x.a === arrive && x.str > 0.5; });
            if (o.length) { p.edge = o[(Math.random() * o.length) | 0]; p.t = 0; return true; }
            n.epoch++;
            return false;
          }
          return true;
        });
        n.dash -= dt * 4;

        var cs = getComputedStyle(document.documentElement);
        var accent = (cs.getPropertyValue('--accent').trim()) || '#4b5bdd';
        var muted = (cs.getPropertyValue('--muted').trim()) || '#8c887e';
        var ink = (cs.getPropertyValue('--ink').trim()) || '#1b1916';
        var pad = 12;
        var P = function (nd) { return [pad + nd.x * (w - 2 * pad), pad + nd.y * (h - 2 * pad)]; };

        ctx.lineWidth = 1; ctx.lineCap = 'round'; ctx.setLineDash([1.5, 5]); ctx.lineDashOffset = n.dash; ctx.strokeStyle = muted;
        for (var e2 = 0; e2 < n.edges.length; e2++) {
          var edg = n.edges[e2];
          if (edg.str < 0.06) continue;
          var pa = P(n.nodes[edg.a]), pb = P(n.nodes[edg.b]);
          ctx.globalAlpha = edg.str * 0.42;
          ctx.beginPath(); ctx.moveTo(pa[0], pa[1]); ctx.lineTo(pb[0], pb[1]); ctx.stroke();
        }
        ctx.setLineDash([]); ctx.globalAlpha = 1;

        ctx.font = '8px "JetBrains Mono", monospace'; ctx.textBaseline = 'middle';
        for (var nd2 = 0; nd2 < n.nodes.length; nd2++) {
          var node = n.nodes[nd2];
          var pp = P(node);
          ctx.lineWidth = 1.3; ctx.strokeStyle = ink; ctx.globalAlpha = 0.5;
          ctx.beginPath(); ctx.arc(pp[0], pp[1], 3, 0, 6.2832); ctx.stroke();
          ctx.globalAlpha = 0.34; ctx.fillStyle = ink;
          ctx.fillText(node.act.toFixed(2), pp[0] + 6, pp[1]);
        }
        ctx.globalAlpha = 1;

        ctx.shadowColor = accent; ctx.fillStyle = accent;
        for (var pi = 0; pi < n.pulses.length; pi++) {
          var p2 = n.pulses[pi];
          var A = n.nodes[p2.edge.a], B = n.nodes[p2.edge.b];
          var av = P(A), bv = P(B);
          var x = av[0] + (bv[0] - av[0]) * p2.t, y = av[1] + (bv[1] - av[1]) * p2.t;
          ctx.shadowBlur = 10; ctx.globalAlpha = 1;
          ctx.beginPath(); ctx.arc(x, y, 2.8, 0, 6.2832); ctx.fill();
        }
        ctx.shadowBlur = 0; ctx.globalAlpha = 1;

        var strSum = 0, active = 0;
        for (var e3 = 0; e3 < n.edges.length; e3++) { strSum += n.edges[e3].str; if (n.edges[e3].str > 0.5) active++; }
        var conn = active / n.edges.length;
        var targetLoss = Math.max(0.021, 0.95 - conn * 1.35);
        var targetAcc = Math.min(99.4, 42 + conn * 92);
        n.dispLoss += (targetLoss - n.dispLoss) * Math.min(1, dt * 0.6);
        n.dispAcc += (targetAcc - n.dispAcc) * Math.min(1, dt * 0.6);
        var set = function (id, val) { var el = document.getElementById(id); if (el && el.textContent !== val) el.textContent = val; };
        set('st-epoch', String(n.epoch).padStart(4, '0'));
        set('st-loss', n.dispLoss.toFixed(4));
        set('st-acc', n.dispAcc.toFixed(1) + '%');
        var legend = document.getElementById('net-stats');
        if (legend) {
          var bl = n.nodes[n.byLayer[0][n.byLayer[0].length - 1]];
          legend.style.paddingLeft = Math.round(P(bl)[0]) + 'px';
        }
      }

      function loop() {
        requestAnimationFrame(loop);
        var cv = document.getElementById('net-canvas');
        if (cv) drawNet(cv);
      }
      loop();
    })();
  </script>
</Layout>
