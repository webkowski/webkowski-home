---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Piotr Łepkowski - Software Engineer - CV">
  <div style="max-width:1080px; margin:0 auto; padding:0 32px;">
    <section style="padding:64px 0 28px;">
      <a href="/" class="link-accent" style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--muted); text-decoration:none; margin-bottom:30px; display:inline-flex; gap:8px;">← back to home</a>
      <h1 style="font-size:clamp(30px,5vw,52px); font-weight:900; letter-spacing:-1.5px; margin:0 0 6px; line-height:1;">Selected work</h1>
      <p style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--muted); margin:0;">the latest and most interesting projects — details on request</p>
    </section>

    <!-- accordion -->
    <section style="padding-bottom:10px;">
      <!-- 01 -->
      <div class="acc-item open" style="border-top:1px solid var(--line14);">
        <div class="acc-head" style="display:flex; align-items:flex-start; gap:20px; padding:24px 4px; cursor:pointer;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accent); font-weight:700; padding-top:6px;">01</span>
          <h2 style="flex:1; margin:0; font-size:clamp(20px,2.6vw,28px); font-weight:700; letter-spacing:-.5px;">Web Application for Trend Prediction Data Analysis</h2>
          <span class="acc-sign" style="font-family:'JetBrains Mono',monospace; font-size:22px; color:var(--accent); width:24px; text-align:center;"></span>
        </div>
        <div class="acc-body">
          <ul style="margin:0 0 24px; padding:0 4px 0 48px; list-style:none; display:flex; flex-direction:column; gap:12px;">
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>User-centric interface for efficient data analysis with interactive charts and visualizations to enhance user insight.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Co-devised a robust data-caching solution, significantly optimizing performance and reducing load times.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Worked with a multi-disciplinary team, ensuring cohesive development aligned with user needs.</li>
          </ul>
        </div>
      </div>
      <!-- 02 -->
      <div class="acc-item" style="border-top:1px solid var(--line14);">
        <div class="acc-head" style="display:flex; align-items:flex-start; gap:20px; padding:24px 4px; cursor:pointer;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accent); font-weight:700; padding-top:6px;">02</span>
          <h2 style="flex:1; margin:0; font-size:clamp(20px,2.6vw,28px); font-weight:700; letter-spacing:-.5px;">Investment Strategy Optimization Platform for Real Estate Investors</h2>
          <span class="acc-sign" style="font-family:'JetBrains Mono',monospace; font-size:22px; color:var(--accent); width:24px; text-align:center;"></span>
        </div>
        <div class="acc-body">
          <ul style="margin:0 0 24px; padding:0 4px 0 48px; list-style:none; display:flex; flex-direction:column; gap:12px;">
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Orchestrated the design and implementation of a UI ensuring clear, impactful data presentation.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Integrated intricate map views providing intuitive, location-based investment insights.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Ensured seamless integration with a backend delivering raw data; pivotal in shaping user experience.</li>
          </ul>
        </div>
      </div>
      <!-- 03 -->
      <div class="acc-item" style="border-top:1px solid var(--line14);">
        <div class="acc-head" style="display:flex; align-items:flex-start; gap:20px; padding:24px 4px; cursor:pointer;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accent); font-weight:700; padding-top:6px;">03</span>
          <h2 style="flex:1; margin:0; font-size:clamp(20px,2.6vw,28px); font-weight:700; letter-spacing:-.5px;">Real-Time Synchronized Multiplatform Task Management Application</h2>
          <span class="acc-sign" style="font-family:'JetBrains Mono',monospace; font-size:22px; color:var(--accent); width:24px; text-align:center;"></span>
        </div>
        <div class="acc-body">
          <ul style="margin:0 0 24px; padding:0 4px 0 48px; list-style:none; display:flex; flex-direction:column; gap:12px;">
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Led development of a backend platform ensuring synchronized task management across web, desktop, and mobile.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Built applications for each platform ensuring seamless inter-platform interoperability.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Managed integration with external platforms for enhanced functionality and data consistency.</li>
          </ul>
        </div>
      </div>
      <!-- 04 -->
      <div class="acc-item" style="border-top:1px solid var(--line14); border-bottom:1px solid var(--line14);">
        <div class="acc-head" style="display:flex; align-items:flex-start; gap:20px; padding:24px 4px; cursor:pointer;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accent); font-weight:700; padding-top:6px;">04</span>
          <h2 style="flex:1; margin:0; font-size:clamp(20px,2.6vw,28px); font-weight:700; letter-spacing:-.5px;">Rich interactive websites</h2>
          <span class="acc-sign" style="font-family:'JetBrains Mono',monospace; font-size:22px; color:var(--accent); width:24px; text-align:center;"></span>
        </div>
        <div class="acc-body">
          <ul style="margin:0 0 24px; padding:0 4px 0 48px; list-style:none; display:flex; flex-direction:column; gap:12px;">
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>End-to-end website development using the latest technologies and current standards.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Stellar user experience through meticulous attention to detail and a user-centric approach.</li>
            <li style="position:relative; font-size:15.5px; line-height:1.6; color:var(--text2); padding-left:20px;"><span style="position:absolute; left:0; color:var(--accent); font-family:'JetBrains Mono',monospace;">—</span>Delivered efficient, visually appealing, functional digital solutions at the forefront of tech.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- STACK -->
    <section style="padding:54px 0 18px;">
      <div style="display:flex; align-items:center; gap:16px; margin-bottom:34px;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accent); font-weight:700;">//</span>
        <span data-text="tech_stack" style="font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:.5px; color:var(--ink); font-weight:500;">tech_stack</span>
        <span style="flex:1; height:1px; background:var(--line14);"></span>
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--muted);">most used</span>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:28px;">
        <div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--muted); margin-bottom:14px;">languages</div>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">JavaScript</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">TypeScript</span>
          </div>
        </div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--muted); margin-bottom:14px;">frameworks</div>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">React/Next.js</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Nest.js</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Koa</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">React Native</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Express</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Astro</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Remix</span>
          </div>
        </div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--muted); margin-bottom:14px;">libraries / apis</div>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">OpenAI</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">D3.js</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Mapbox</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Okta</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Node.js</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Prisma</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Electron</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">Supabase</span>
            <span class="tag" style="font-family:'JetBrains Mono',monospace; font-size:12.5px; padding:6px 11px; border:1px solid var(--line18); border-radius:3px;">TailwindCSS</span>
          </div>
        </div>
      </div>
    </section>
    <div style="height:64px;"></div>
  </div>

  <!-- projects behaviour: accordion (one open at a time) -->
  <script is:inline>
    (function () {
      var items = Array.prototype.slice.call(document.querySelectorAll('.acc-item'));
      items.forEach(function (item) {
        var head = item.querySelector('.acc-head');
        if (!head) return;
        head.addEventListener('click', function () {
          var wasOpen = item.classList.contains('open');
          items.forEach(function (it) { it.classList.remove('open'); });
          if (!wasOpen) item.classList.add('open');
        });
      });
    })();
  </script>
</Layout>
