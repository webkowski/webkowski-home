---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Piotr Łepkowski - Software Engineer - CV">
  <div class="max-w-[1080px] mx-auto px-[32px]">
    <section class="pt-[64px] pb-[28px]">
      <a href="/" class="link-accent font-mono text-[13px] text-muted no-underline mb-[30px] inline-flex gap-[8px]">← back to home</a>
      <h1 class="text-[clamp(30px,5vw,52px)] font-black tracking-[-1.5px] mt-0 mx-0 mb-[6px] leading-[1]">Selected work</h1>
      <p class="font-mono text-[13px] text-muted m-0">the latest and most interesting projects — details on request</p>
    </section>

    <!-- accordion -->
    <section class="pb-[10px]">
      <!-- 01 -->
      <div class="acc-item open border-t border-line14">
        <div class="acc-head flex items-start gap-[20px] px-[4px] py-[24px] cursor-pointer">
          <span class="font-mono text-[13px] text-accent font-bold pt-[6px]">01</span>
          <h2 class="flex-1 m-0 text-[clamp(20px,2.6vw,28px)] font-bold tracking-[-.5px]">Web Application for Trend Prediction Data Analysis</h2>
          <span class="acc-sign font-mono text-[22px] text-accent w-[24px] text-center"></span>
        </div>
        <div class="acc-body">
          <ul class="mt-0 mx-0 mb-[24px] pt-0 pr-[4px] pb-0 pl-[48px] list-none flex flex-col gap-[12px]">
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>User-centric interface for efficient data analysis with interactive charts and visualizations to enhance user insight.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Co-devised a robust data-caching solution, significantly optimizing performance and reducing load times.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Worked with a multi-disciplinary team, ensuring cohesive development aligned with user needs.</li>
          </ul>
        </div>
      </div>
      <!-- 02 -->
      <div class="acc-item border-t border-line14">
        <div class="acc-head flex items-start gap-[20px] px-[4px] py-[24px] cursor-pointer">
          <span class="font-mono text-[13px] text-accent font-bold pt-[6px]">02</span>
          <h2 class="flex-1 m-0 text-[clamp(20px,2.6vw,28px)] font-bold tracking-[-.5px]">Investment Strategy Optimization Platform for Real Estate Investors</h2>
          <span class="acc-sign font-mono text-[22px] text-accent w-[24px] text-center"></span>
        </div>
        <div class="acc-body">
          <ul class="mt-0 mx-0 mb-[24px] pt-0 pr-[4px] pb-0 pl-[48px] list-none flex flex-col gap-[12px]">
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Orchestrated the design and implementation of a UI ensuring clear, impactful data presentation.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Integrated intricate map views providing intuitive, location-based investment insights.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Ensured seamless integration with a backend delivering raw data; pivotal in shaping user experience.</li>
          </ul>
        </div>
      </div>
      <!-- 03 -->
      <div class="acc-item border-t border-line14">
        <div class="acc-head flex items-start gap-[20px] px-[4px] py-[24px] cursor-pointer">
          <span class="font-mono text-[13px] text-accent font-bold pt-[6px]">03</span>
          <h2 class="flex-1 m-0 text-[clamp(20px,2.6vw,28px)] font-bold tracking-[-.5px]">Real-Time Synchronized Multiplatform Task Management Application</h2>
          <span class="acc-sign font-mono text-[22px] text-accent w-[24px] text-center"></span>
        </div>
        <div class="acc-body">
          <ul class="mt-0 mx-0 mb-[24px] pt-0 pr-[4px] pb-0 pl-[48px] list-none flex flex-col gap-[12px]">
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Led development of a backend platform ensuring synchronized task management across web, desktop, and mobile.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Built applications for each platform ensuring seamless inter-platform interoperability.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Managed integration with external platforms for enhanced functionality and data consistency.</li>
          </ul>
        </div>
      </div>
      <!-- 04 -->
      <div class="acc-item border-t border-b border-line14">
        <div class="acc-head flex items-start gap-[20px] px-[4px] py-[24px] cursor-pointer">
          <span class="font-mono text-[13px] text-accent font-bold pt-[6px]">04</span>
          <h2 class="flex-1 m-0 text-[clamp(20px,2.6vw,28px)] font-bold tracking-[-.5px]">Rich interactive websites</h2>
          <span class="acc-sign font-mono text-[22px] text-accent w-[24px] text-center"></span>
        </div>
        <div class="acc-body">
          <ul class="mt-0 mx-0 mb-[24px] pt-0 pr-[4px] pb-0 pl-[48px] list-none flex flex-col gap-[12px]">
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>End-to-end website development using the latest technologies and current standards.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Stellar user experience through meticulous attention to detail and a user-centric approach.</li>
            <li class="relative text-[15.5px] leading-[1.6] text-text2 pl-[20px]"><span class="absolute left-0 text-accent font-mono">—</span>Delivered efficient, visually appealing, functional digital solutions at the forefront of tech.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- STACK -->
    <section class="pt-[54px] pb-[18px]">
      <div class="flex items-center gap-[16px] mb-[34px]">
        <span class="font-mono text-[13px] text-accent font-bold">//</span>
        <span data-text="tech_stack" class="font-mono text-[13px] tracking-[.5px] text-ink font-medium">tech_stack</span>
        <span class="flex-1 h-px bg-line14"></span>
        <span class="font-mono text-[12px] text-muted">most used</span>
      </div>
      <div class="grid grid-cols-3 gap-[28px]">
        <div>
          <div class="font-mono text-[12px] text-muted mb-[14px]">languages</div>
          <div class="flex flex-wrap gap-[8px]">
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">JavaScript</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">TypeScript</span>
          </div>
        </div>
        <div>
          <div class="font-mono text-[12px] text-muted mb-[14px]">frameworks</div>
          <div class="flex flex-wrap gap-[8px]">
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">React/Next.js</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Nest.js</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Koa</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">React Native</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Express</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Astro</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Remix</span>
          </div>
        </div>
        <div>
          <div class="font-mono text-[12px] text-muted mb-[14px]">libraries / apis</div>
          <div class="flex flex-wrap gap-[8px]">
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">OpenAI</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">D3.js</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Mapbox</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Okta</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Node.js</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Prisma</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Electron</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">Supabase</span>
            <span class="tag font-mono text-[12.5px] px-[11px] py-[6px] border border-line18 rounded-[3px]">TailwindCSS</span>
          </div>
        </div>
      </div>
    </section>
    <div class="h-[64px]"></div>
  </div>

  <!-- projects behaviour: accordion (one open at a time) -->
  <script is:inline>
    (function () {
      var items = Array.prototype.slice.call(document.querySelectorAll('.acc-item'));
      items.forEach(function (item) {
        var head = item.querySelector('.acc-head');
        if (!head) return;
        head.addEventListener('click', function () {
          var wasOpen = item.classList.contains('open');
          items.forEach(function (it) { it.classList.remove('open'); });
          if (!wasOpen) item.classList.add('open');
        });
      });
    })();
  </script>
</Layout>
